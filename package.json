{
  "name": "@summerisgood/paseo-next-check",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "client/*.ts",
    "client/*.tsx",
    "shared/*.ts",
    "!client/*.test.ts",
    "!shared/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test shared/*.test.ts client/*.test.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.0-beta.4",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "description": "Open the oldest unread agent reply across Paseo workspaces, with a native workspace Mark as unread shortcut.",
  "author": "summerisgood",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/summerisgood1/paseo-next-check.git"
  },
  "homepage": "https://github.com/summerisgood1/paseo-next-check#readme",
  "bugs": {
    "url": "https://github.com/summerisgood1/paseo-next-check/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "productivity",
    "unread",
    "agents"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
